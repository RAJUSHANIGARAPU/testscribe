# ============================================================================
# TestScribe — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# REQUIRED variables must be set before the app will start.
# NEVER commit .env to version control.
# ============================================================================

# Application
APP_NAME=TestScribe
APP_ENV=development
APP_URL=http://localhost:8000
DEBUG=false
LOG_LEVEL=INFO

# Database
# SQLite (default, good for MVP):
DATABASE_URL=sqlite:///./testscribe.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/testscribe

# JWT Authentication — REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_32_char_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Anthropic Claude API — REQUIRED
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TIMEOUT=60.0

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=60.0

# Stripe Payments — REQUIRED for billing
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Create products+prices at: https://dashboard.stripe.com/products
STRIPE_PRICE_SOLO=price_solo_monthly_id_here
STRIPE_PRICE_PRO=price_pro_monthly_id_here
STRIPE_PRICE_TEAM=price_team_monthly_id_here

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_IP=60/minute
RATE_LIMIT_GENERATE=20/minute

# Background Workers
TASK_POLL_INTERVAL=2.0
TASK_REAPER_INTERVAL=300.0
